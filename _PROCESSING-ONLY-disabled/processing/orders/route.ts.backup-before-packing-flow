import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { getCurrentSession } from "@/lib/auth";

const TERMINAL_STATUSES = [
  "Delivered",
  "Cancelled",
];

const STARTABLE_STATUSES = [
  "Pending",
  "Confirmed",
  "Paid",
  "Payment Received",
];

async function requireProcessingStaff() {
  const session = await getCurrentSession();

  if (
    !session ||
    session.kind !== "staff" ||
    String(session.role).toUpperCase() !== "PROCESSING"
  ) {
    return null;
  }

  return session;
}

export async function GET() {
  try {
    const session = await requireProcessingStaff();

    if (!session) {
      return NextResponse.json(
        { error: "Unauthorized" },
        { status: 401 }
      );
    }

    const orders = await prisma.order.findMany({
      where: {
        status: {
          notIn: TERMINAL_STATUSES,
        },
      },
      orderBy: {
        createdAt: "asc",
      },
    });

    const orderIds = orders.map((order) => order.id);

    const orderItems =
      orderIds.length > 0
        ? await prisma.orderItem.findMany({
            where: {
              orderId: {
                in: orderIds,
              },
            },
            orderBy: {
              id: "asc",
            },
          })
        : [];

    const productIds = [
      ...new Set(
        orderItems
          .map((item) => item.productId)
          .filter(
            (id): id is number =>
              Number.isInteger(id)
          )
      ),
    ];

    const products =
      productIds.length > 0
        ? await prisma.product.findMany({
            where: {
              id: {
                in: productIds,
              },
            },
            select: {
              id: true,
              name: true,
              pack: true,
            },
          })
        : [];

    const productMap = new Map(
      products.map((product) => [
        product.id,
        product,
      ])
    );

    const itemsByOrder = new Map<
      number,
      Array<{
        id: number;
        productId: number;
        productName: string;
        pack: string;
        quantity: number;
        price: number;
        total: number;
      }>
    >();

    for (const item of orderItems) {
      const product = productMap.get(
        item.productId
      );

      const mappedItem = {
        id: item.id,
        productId: item.productId,
        productName:
          product?.name ||
          item.productName ||
          "Product",
        pack:
          product?.pack ||
          "-",
        quantity: Number(
          item.quantity || 0
        ),
        price: Number(
          item.price || 0
        ),
        total: Number(
          item.total || 0
        ),
      };

      const existing =
        itemsByOrder.get(
          item.orderId
        ) || [];

      existing.push(mappedItem);

      itemsByOrder.set(
        item.orderId,
        existing
      );
    }

    const enrichedOrders = orders.map(
      (order) => ({
        ...order,
        items:
          itemsByOrder.get(order.id) || [],
      })
    );

    return NextResponse.json({
      success: true,
      orders: enrichedOrders,
    });
  } catch (error) {
    console.error(
      "PROCESSING ORDERS GET ERROR:",
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Failed to load processing orders",
      },
      { status: 500 }
    );
  }
}

export async function PATCH(req: Request) {
  try {
    const session =
      await requireProcessingStaff();

    if (!session) {
      return NextResponse.json(
        { error: "Unauthorized" },
        { status: 401 }
      );
    }

    const body = await req.json();

    const id = Number(body?.id);
    const action = String(
      body?.action || ""
    ).trim();

    if (!Number.isInteger(id) || id <= 0) {
      return NextResponse.json(
        {
          error:
            "Valid order ID is required",
        },
        { status: 400 }
      );
    }

    if (
      !["start", "ready"].includes(
        action
      )
    ) {
      return NextResponse.json(
        {
          error:
            "Invalid processing action",
        },
        { status: 400 }
      );
    }

    const order =
      await prisma.order.findUnique({
        where: { id },
      });

    if (!order) {
      return NextResponse.json(
        { error: "Order not found" },
        { status: 404 }
      );
    }

    const now = new Date();

    if (action === "start") {
      if (
        !STARTABLE_STATUSES.includes(
          order.status
        )
      ) {
        return NextResponse.json(
          {
            error:
              `Order cannot start processing from status: ${order.status}`,
          },
          { status: 400 }
        );
      }

      const processingDeadline =
        new Date(
          now.getTime() +
            30 * 60 * 1000
        );

      const staffId = Number(
        (
          session as {
            staffId?: number;
          }
        ).staffId
      );

      if (
        !Number.isInteger(staffId) ||
        staffId <= 0
      ) {
        return NextResponse.json(
          {
            error:
              "Processing staff session is invalid",
          },
          { status: 401 }
        );
      }

      const updated =
        await prisma.order.update({
          where: { id },
          data: {
            status: "Processing",
            processingUserId:
              staffId,
            processingStartedAt:
              now,
            processingDeadline,
          },
        });

      return NextResponse.json({
        success: true,
        action: "start",
        order: updated,
      });
    }

    if (
      order.status !== "Processing"
    ) {
      return NextResponse.json(
        {
          error:
            "Only Processing orders can be marked Ready For Dispatch",
        },
        { status: 400 }
      );
    }

    const updated =
      await prisma.order.update({
        where: { id },
        data: {
          status:
            "Ready For Dispatch",
          readyAt: now,
        },
      });

    return NextResponse.json({
      success: true,
      action: "ready",
      order: updated,
    });
  } catch (error) {
    console.error(
      "PROCESSING ORDERS PATCH ERROR:",
      error
    );

    return NextResponse.json(
      {
        error:
          error instanceof Error
            ? error.message
            : "Failed to update processing order",
      },
      { status: 500 }
    );
  }
}
