"use client";

import {
  useCallback,
  useEffect,
  useState,
} from "react";

type OrderItem = {
  id: number;
  productId: number;
  productName: string;
  pack: string;
  quantity: number;
  price: number;
  total: number;
  packed: boolean;
};

type Order = {
  id: number;
  customer: string;
  phone: string | null;
  address: string | null;
  amount: number;
  status: string;
  createdAt: string;
  processingDeadline?: string | null;
  readyAt?: string | null;
  items: OrderItem[];
};

type ApiResponse = {
  success?: boolean;
  orders?: Order[];
  error?: string;
};

function money(value: number) {
  return `₹${Number(
    value || 0
  ).toLocaleString("en-IN")}`;
}

function dateText(value: string) {
  return new Date(
    value
  ).toLocaleString(
    "en-IN",
    {
      dateStyle: "medium",
      timeStyle: "short",
    }
  );
}

function remainingSeconds(
  deadline?: string | null
) {
  if (!deadline) return 0;

  return Math.max(
    0,
    Math.ceil(
      (
        new Date(
          deadline
        ).getTime() -
        Date.now()
      ) / 1000
    )
  );
}

function timerText(
  seconds: number
) {
  const minutes =
    Math.floor(
      seconds / 60
    );

  const secs =
    seconds % 60;

  return `${String(
    minutes
  ).padStart(
    2,
    "0"
  )}:${String(
    secs
  ).padStart(
    2,
    "0"
  )}`;
}

export default function ProcessingDashboardPage() {
  const [orders, setOrders] =
    useState<Order[]>([]);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  const [busyId, setBusyId] =
    useState<number | null>(
      null
    );

  const [tick, setTick] =
    useState(Date.now());

  /*
   * Orders currently being packed.
   * Auto refresh does NOT overwrite these
   * local checkbox selections.
   */
  const [dirtyOrders, setDirtyOrders] =
    useState<number[]>(
      []
    );

  const loadOrders =
    useCallback(
      async () => {
        try {
          const response =
            await fetch(
              "/api/processing/orders",
              {
                cache:
                  "no-store",
                credentials:
                  "include",
              }
            );

          const data: ApiResponse =
            await response.json();

          if (!response.ok) {
            throw new Error(
              data.error ||
                "Failed to load orders"
            );
          }

          const incoming =
            Array.isArray(
              data.orders
            )
              ? data.orders
              : [];

          setOrders(
            (current) => {
              const dirtySet =
                new Set(
                  dirtyOrders
                );

              return incoming.map(
                (serverOrder) => {
                  if (
                    !dirtySet.has(
                      serverOrder.id
                    )
                  ) {
                    return serverOrder;
                  }

                  const local =
                    current.find(
                      (item) =>
                        item.id ===
                        serverOrder.id
                    );

                  if (!local) {
                    return serverOrder;
                  }

                  return {
                    ...serverOrder,
                    items:
                      serverOrder.items.map(
                        (
                          serverItem
                        ) => {
                          const localItem =
                            local.items.find(
                              (
                                item
                              ) =>
                                item.id ===
                                serverItem.id
                            );

                          return localItem
                            ? {
                                ...serverItem,
                                packed:
                                  localItem.packed,
                              }
                            : serverItem;
                        }
                      ),
                  };
                }
              );
            }
          );

          setError("");
        } catch (err) {
          setError(
            err instanceof Error
              ? err.message
              : "Failed to load orders"
          );
        } finally {
          setLoading(false);
        }
      },
      [dirtyOrders]
    );

  useEffect(() => {
    loadOrders();

    const refresh =
      window.setInterval(
        loadOrders,
        5000
      );

    const clock =
      window.setInterval(
        () => {
          setTick(
            Date.now()
          );
        },
        1000
      );

    return () => {
      window.clearInterval(
        refresh
      );

      window.clearInterval(
        clock
      );
    };
  }, [loadOrders]);

  function togglePacking(
    orderId: number,
    itemId: number,
    checked: boolean
  ) {
    setDirtyOrders(
      (current) =>
        current.includes(
          orderId
        )
          ? current
          : [
              ...current,
              orderId,
            ]
    );

    setOrders(
      (current) =>
        current.map(
          (order) =>
            order.id !==
            orderId
              ? order
              : {
                  ...order,
                  items:
                    order.items.map(
                      (item) =>
                        item.id !==
                        itemId
                          ? item
                          : {
                              ...item,
                              packed:
                                checked,
                            }
                    ),
                }
        )
    );
  }

  async function processOrder(
    orderId: number
  ) {
    try {
      setBusyId(
        orderId
      );

      setError("");

      const response =
        await fetch(
          "/api/processing/orders",
          {
            method: "PATCH",
            headers: {
              "Content-Type":
                "application/json",
            },
            credentials:
              "include",
            body: JSON.stringify({
              id: orderId,
              action:
                "processOrder",
            }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.error ||
            "Failed to process order"
        );
      }

      /*
       * Now database is committed.
       * Remove local override.
       */
      setDirtyOrders(
        (current) =>
          current.filter(
            (id) =>
              id !== orderId
          )
      );

      await loadOrders();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to process order"
      );
    } finally {
      setBusyId(
        null
      );
    }
  }

  async function readyForDispatch(
    orderId: number
  ) {
    try {
      setBusyId(
        orderId
      );

      const response =
        await fetch(
          "/api/processing/orders",
          {
            method: "PATCH",
            headers: {
              "Content-Type":
                "application/json",
            },
            credentials:
              "include",
            body: JSON.stringify({
              id: orderId,
              action:
                "ready",
            }),
          }
        );

      const data =
        await response.json();

      if (!response.ok) {
        throw new Error(
          data.error ||
            "Failed to mark ready"
        );
      }

      await loadOrders();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Failed to mark ready"
      );
    } finally {
      setBusyId(
        null
      );
    }
  }

  async function logout() {
    await fetch(
      "/api/auth/logout",
      {
        method: "POST",
        credentials:
          "include",
      }
    );

    window.location.href =
      "/processing/login";
  }

  const newOrders =
    orders.filter(
      (order) =>
        [
          "Pending",
          "Confirmed",
          "Paid",
          "Payment Received",
        ].includes(
          order.status
        )
    );

  const processingOrders =
    orders.filter(
      (order) =>
        order.status ===
        "Processing"
    );

  const readyOrders =
    orders.filter(
      (order) =>
        order.status ===
        "Ready For Dispatch"
    );

  return (
    <main className="min-h-screen bg-slate-50 p-4 md:p-8">
      <div className="mx-auto max-w-7xl">
        <div className="rounded-3xl bg-white p-6 shadow-sm">

          <div className="flex flex-wrap items-center justify-between gap-4">

            <div>
              <div className="text-sm font-bold text-emerald-600">
                Fresh2Cook Operations
              </div>

              <h1 className="mt-1 text-3xl font-black text-slate-900">
                Processing Dashboard
              </h1>

              <p className="mt-1 text-sm text-slate-500">
                Packing verification &
                processing control
              </p>
            </div>

            <button
              type="button"
              onClick={logout}
              className="rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-700"
            >
              Logout
            </button>

          </div>


          <div className="mt-8 grid gap-4 md:grid-cols-3">

            <div className="rounded-2xl bg-emerald-50 p-5">
              <div className="text-sm font-bold text-emerald-700">
                New Orders
              </div>

              <div className="mt-2 text-3xl font-black">
                {newOrders.length}
              </div>
            </div>


            <div className="rounded-2xl bg-orange-50 p-5">
              <div className="text-sm font-bold text-orange-700">
                Processing
              </div>

              <div className="mt-2 text-3xl font-black">
                {processingOrders.length}
              </div>
            </div>


            <div className="rounded-2xl bg-blue-50 p-5">
              <div className="text-sm font-bold text-blue-700">
                Ready For Dispatch
              </div>

              <div className="mt-2 text-3xl font-black">
                {readyOrders.length}
              </div>
            </div>

          </div>


          {error && (
            <div className="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 font-bold text-red-700">
              {error}
            </div>
          )}


          <section className="mt-8 overflow-hidden rounded-3xl border border-slate-200">

            <div className="border-b bg-slate-50 px-5 py-5">

              <h2 className="text-xl font-black text-slate-900">
                Processing Queue
              </h2>

              <p className="mt-1 text-sm text-slate-500">
                सभी products pack करके checkbox tick करें।
                फिर Process Order दबाएँ।
              </p>

            </div>


            {loading ? (

              <div className="p-10 text-center text-slate-500">
                Loading orders...
              </div>

            ) : (

              <div className="divide-y divide-slate-200">

                {orders.map(
                  (
                    order
                  ) => {

                    const isStartable =
                      [
                        "Pending",
                        "Confirmed",
                        "Paid",
                        "Payment Received",
                      ].includes(
                        order.status
                      );

                    const isProcessing =
                      order.status ===
                      "Processing";

                    const isReady =
                      order.status ===
                      "Ready For Dispatch";

                    const packedCount =
                      order.items.filter(
                        (
                          item
                        ) =>
                          item.packed
                      ).length;

                    const allPacked =
                      order.items.length >
                        0 &&
                      order.items.every(
                        (
                          item
                        ) =>
                          item.packed
                      );

                    const seconds =
                      isProcessing
                        ? remainingSeconds(
                            order.processingDeadline
                          )
                        : 0;

                    const overdue =
                      isProcessing &&
                      !!order.processingDeadline &&
                      new Date(
                        order.processingDeadline
                      ).getTime() <
                        tick;

                    return (

                      <div
                        key={
                          order.id
                        }
                        className="p-5 md:p-6"
                      >

                        <div className="flex flex-col gap-4">

                          {/* ORDER HEADER */}

                          <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">

                            <div>

                              <div className="flex flex-wrap items-center gap-2">

                                <span className="text-xl font-black text-slate-900">
                                  Order #
                                  {
                                    order.id
                                  }
                                </span>

                                <span className="rounded-full bg-slate-100 px-3 py-1 text-xs font-black">
                                  {
                                    order.status
                                  }
                                </span>

                              </div>

                              <div className="mt-3 text-lg font-bold">
                                {
                                  order.customer
                                }
                              </div>

                              <div className="mt-1 text-sm text-slate-500">
                                {
                                  order.phone
                                }
                              </div>

                              <div className="mt-1 text-sm text-slate-500">
                                {
                                  order.address
                                }
                              </div>

                              <div className="mt-3 text-sm font-black">
                                Order Value:{" "}
                                {money(
                                  order.amount
                                )}
                              </div>

                            </div>


                            {isProcessing && (

                              <div className="rounded-2xl bg-orange-50 px-6 py-4 text-center">

                                <div className="text-xs font-bold uppercase tracking-wide text-slate-500">
                                  Time Remaining
                                </div>

                                <div
                                  className={`mt-1 text-3xl font-black tabular-nums ${
                                    overdue
                                      ? "text-red-600"
                                      : "text-orange-600"
                                  }`}
                                >
                                  {overdue
                                    ? "00:00"
                                    : timerText(
                                        seconds
                                      )}
                                </div>

                              </div>

                            )}


                            {isReady && (

                              <div className="rounded-2xl bg-blue-50 px-6 py-4 text-center">

                                <div className="text-xs font-bold text-blue-600">
                                  DISPATCH QUEUE
                                </div>

                                <div className="font-black text-blue-900">
                                  READY
                                </div>

                              </div>

                            )}

                          </div>


                          {/* PACKING GRID */}

                          <div className="rounded-2xl border-2 border-emerald-100 bg-emerald-50/50 p-4">

                            <div className="mb-4 flex flex-wrap items-center justify-between gap-3">

                              <div>
                                <h3 className="text-lg font-black">
                                  WHAT TO PACK
                                </h3>

                                <p className="mt-1 text-sm text-slate-500">
                                  Packing Checklist
                                </p>
                              </div>

                              <div
                                className={`rounded-full px-4 py-2 text-sm font-black ${
                                  allPacked
                                    ? "bg-emerald-600 text-white"
                                    : "bg-white text-emerald-700"
                                }`}
                              >
                                Packed{" "}
                                {
                                  packedCount
                                } /{" "}
                                {
                                  order.items.length
                                }
                              </div>

                            </div>


                            <div className="overflow-hidden rounded-2xl bg-white shadow-sm">

                              <div className="hidden grid-cols-[70px_minmax(240px,1fr)_170px_90px_130px_120px] bg-slate-900 px-4 py-4 text-sm font-black text-white md:grid">

                                <div>
                                  SR NO
                                </div>

                                <div>
                                  PRODUCT
                                </div>

                                <div>
                                  PACK / WEIGHT
                                </div>

                                <div className="text-center">
                                  QTY
                                </div>

                                <div className="text-right">
                                  AMOUNT
                                </div>

                                <div className="text-center">
                                  PACKED
                                </div>

                              </div>


                              <div className="divide-y divide-slate-200">

                                {order.items.map(
                                  (
                                    item,
                                    index
                                  ) => (

                                    <label
                                      key={
                                        item.id
                                      }
                                      className={[
                                        "grid cursor-pointer grid-cols-1 gap-3 px-4 py-4",
                                        "md:grid-cols-[70px_minmax(240px,1fr)_170px_90px_130px_120px] md:items-center md:gap-0",
                                        item.packed
                                          ? "bg-emerald-50"
                                          : "bg-white",
                                      ].join(
                                        " "
                                      )}
                                    >

                                      <div className="font-black text-slate-400">
                                        <span className="md:hidden">
                                          SR NO:{" "}
                                        </span>
                                        {
                                          index +
                                          1
                                        }
                                      </div>


                                      <div className="font-black text-slate-900">
                                        {
                                          item.productName
                                        }
                                      </div>


                                      <div className="font-semibold text-slate-600">
                                        <span className="md:hidden">
                                          Pack:{" "}
                                        </span>
                                        {
                                          item.pack
                                        }
                                      </div>


                                      <div className="font-black md:text-center">
                                        <span className="md:hidden">
                                          Qty:{" "}
                                        </span>
                                        {
                                          item.quantity
                                        }
                                      </div>


                                      <div className="font-bold md:text-right">
                                        <span className="md:hidden">
                                          Amount:{" "}
                                        </span>
                                        {money(
                                          item.total
                                        )}
                                      </div>


                                      <div className="flex items-center gap-3 md:justify-center">

                                        <input
                                          type="checkbox"
                                          checked={
                                            item.packed
                                          }
                                          disabled={
                                            !isStartable
                                          }
                                          onChange={(
                                            e
                                          ) =>
                                            togglePacking(
                                              order.id,
                                              item.id,
                                              e.target.checked
                                            )
                                          }
                                          className="h-7 w-7 cursor-pointer accent-emerald-600"
                                        />

                                        <span
                                          className={`text-xs font-black ${
                                            item.packed
                                              ? "text-emerald-600"
                                              : "text-slate-400"
                                          }`}
                                        >
                                          {
                                            item.packed
                                              ? "PACKED"
                                              : "PENDING"
                                          }
                                        </span>

                                      </div>

                                    </label>

                                  )
                                )}

                              </div>

                            </div>


                            {/* PROCESS ORDER */}

                            {isStartable && (

                              <div className="mt-5 flex flex-col items-center">

                                <p className="mb-3 text-center text-sm font-semibold text-slate-500">

                                  {allPacked
                                    ? "✅ सभी packing items complete हैं"
                                    : `Packing Complete: ${packedCount} / ${order.items.length}`}

                                </p>

                                <button
                                  type="button"
                                  disabled={
                                    !allPacked ||
                                    busyId ===
                                      order.id
                                  }
                                  onClick={() =>
                                    processOrder(
                                      order.id
                                    )
                                  }
                                  className={`w-full max-w-lg rounded-2xl px-6 py-4 text-lg font-black text-white shadow-md transition ${
                                    allPacked
                                      ? "bg-emerald-600 hover:bg-emerald-700"
                                      : "cursor-not-allowed bg-slate-300"
                                  }`}
                                >
                                  {busyId ===
                                  order.id
                                    ? "Processing Order..."
                                    : "✅ Process Order"}
                                </button>

                              </div>

                            )}


                            {/* READY */}

                            {isProcessing && (

                              <div className="mt-5 flex justify-center">

                                <button
                                  type="button"
                                  disabled={
                                    busyId ===
                                    order.id
                                  }
                                  onClick={() =>
                                    readyForDispatch(
                                      order.id
                                    )
                                  }
                                  className="w-full max-w-lg rounded-2xl bg-blue-600 px-6 py-4 text-lg font-black text-white hover:bg-blue-700 disabled:opacity-50"
                                >
                                  {busyId ===
                                  order.id
                                    ? "Saving..."
                                    : "🚚 Ready For Dispatch"}
                                </button>

                              </div>

                            )}

                          </div>

                        </div>

                      </div>

                    );
                  }
                )}

              </div>

            )}

          </section>

        </div>
      </div>
    </main>
  );
}
