"use client";

import { useEffect, useState } from "react";

export default function AssignOrdersPage() {
  const [orders, setOrders] =
    useState<any[]>([]);

  const [deliveryBoys, setDeliveryBoys] =
    useState<any[]>([]);

  useEffect(() => {
    loadData();
  }, []);

  function loadData() {
    const orderData = JSON.parse(
      localStorage.getItem(
        "freshcut-orders"
      ) || "[]"
    );

    const boyData = JSON.parse(
      localStorage.getItem(
        "freshcut-delivery-boys"
      ) || "[]"
    );

    setOrders(orderData);
    setDeliveryBoys(boyData);
  }

  function assignOrder(
    orderId: number,
    boyName: string
  ) {
    const updated =
      orders.map((order) =>
        order.id === orderId
          ? {
              ...order,
              assignedTo:
                boyName,
            }
          : order
      );

    localStorage.setItem(
      "freshcut-orders",
      JSON.stringify(updated)
    );

    setOrders(updated);

    alert(
      "Order Assigned Successfully"
    );
  }

  return (
    <div className="min-h-screen bg-gray-100 p-6">

      <div className="max-w-7xl mx-auto">

        <h1 className="text-4xl font-bold mb-8">
          Assign Orders
        </h1>

        <div className="space-y-6">

          {orders.map(
            (order) => (

              <div
                key={order.id}
                className="bg-white rounded-3xl shadow p-6"
              >

                <div className="flex justify-between items-start">

                  <div>

                    <h2 className="text-2xl font-bold">
                      FC-{order.id}
                    </h2>

                    <p>
                      {
                        order.customer
                      }
                    </p>

                    <p>
                      {
                        order.phone
                      }
                    </p>

                    <p>
                      {
                        order.address
                      }
                    </p>

                    <p className="mt-2 font-semibold text-green-600">
                      Assigned:
                      {" "}
                      {order.assignedTo ||
                        "Not Assigned"}
                    </p>

                  </div>

                  <div>

                    <p className="text-3xl font-bold text-green-600">
                      ₹{order.total}
                    </p>

                  </div>

                </div>

                <div className="mt-6">

                  <select
                    onChange={(e) =>
                      assignOrder(
                        order.id,
                        e.target.value
                      )
                    }
                    className="border p-3 rounded-xl w-full"
                    defaultValue=""
                  >

                    <option value="">
                      Select Delivery Boy
                    </option>

                    {deliveryBoys.map(
                      (boy) => (

                        <option
                          key={boy.id}
                          value={
                            boy.name
                          }
                        >
                          {boy.name}
                        </option>

                      )
                    )}

                  </select>

                </div>

              </div>

            )
          )}

        </div>

      </div>

    </div>
  );
}

